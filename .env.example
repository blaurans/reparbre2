# OAuth Google (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=ton_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=ton_secret

# URL de rappel OAuth (doit correspondre à celle déclarée chez Google)
GOOGLE_REDIRECT_URI=https://reparbre2.laurans.org/auth/google/callback

# URL publique de l'app (utilisée par SvelteKit pour les liens absolus)
ORIGIN=https://reparbre2.laurans.org

# Dossier où stocker la base SQLite
DATA_DIR=./data
